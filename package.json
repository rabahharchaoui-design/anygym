{
  "name": "anygym",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/secret-scan.mjs && node scripts/size-guard.mjs",
    "size": "node scripts/size-guard.mjs",
    "lint": "eslint src && node scripts/boundary-baseline.mjs",
    "secrets": "node scripts/secret-scan.mjs",
    "perf:bundle": "node scripts/perf-budget.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node scripts/dup-guard.mjs",
    "test:ui": "playwright test",
    "test:golden": "playwright test tests/golden --project=\"iPhone 15\" --timeout=90000",
    "test:perf": "playwright test tests/perf --project=\"iPhone 15\" --workers=1",
    "test:live": "playwright test -c playwright.live.config.ts",
    "icons": "node scripts/make-icons.mjs",
    "test:coverage": "vitest run --coverage",
    "plan-exercises": "node scripts/build-plan-exercises.ts",
    "catalog": "node scripts/build-catalog.ts",
    "muscle-report": "node scripts/muscle-report.ts",
    "candidates": "node --import ./scripts/ts-resolve.mjs scripts/build-candidates.ts",
    "coverage-report": "node --import ./scripts/ts-resolve.mjs scripts/coverage-report.ts"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/eslint-parser": "^8.1.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.6",
    "jscpd": "^5.4.3",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  }
}
